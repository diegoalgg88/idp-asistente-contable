            'budget_variance_percent': 0.50,
            'over_90_days_ratio': 0.80,
            'unpaid_taxes': True,
        }
        
        result = analyzer.calculate_score(metrics)
        
        assert result['score'] >= 0
        assert result['score'] <= 100


