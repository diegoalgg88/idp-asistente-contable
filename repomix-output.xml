                </TabsContent>

                <TabsContent value="workflow" className="flex-1 mt-0 outline-none">
                  <div className="grid grid-cols-1 gap-4">
                    <Card className="bg-card border-border hover:border-primary/50 transition-all cursor-pointer group p-4">
