    fc = payload.get("fixed_costs", 0.0)
    price = payload.get("price_per_unit", 0.0)
    vc = payload.get("variable_cost_per_unit", 0.0)
    
    analyzer = BudgetAnalyzer()
    return analyzer.break_even_point(fc, vc, price)
