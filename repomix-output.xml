    fiscal_score -= min(pending * 0.5, 3.0)  # Max -3 puntos

# Penalizar si no hay conciliación bancaria
if not bank_transactions:
    fiscal_score -= 2.0

# Bonus por documentos completados
if completed > 10:
    fiscal_score += min((completed - 10) * 0.1, 2.0)  # Max +2 puntos

