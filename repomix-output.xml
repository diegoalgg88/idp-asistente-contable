    <cfdi:Receptor Rfc="XEXX010101000" Nombre="Cliente Test" DomicilioFiscalReceptor="06600"
        RegimenFiscalReceptor="616" UsoCFDI="G03"/>
    
    <cfdi:Conceptos>
        <cfdi:Concepto ClaveProdServ="01010101" Cantidad="1" ClaveUnidad="E48"
