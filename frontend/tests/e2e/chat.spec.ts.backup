/**
 * Chat E2E Tests
 * 
 * Tests para el flujo de Chat del IDP Asistente Contable.
 * Incluye tests para crear conversación, enviar mensajes y eliminar conversación.
 * 
 * @module tests/e2e/chat.spec
 */

import { test, expect } from '../fixtures'

test.describe('Chat - Agente Fiscal AI', () => {
  // Configurar timeout para tests de chat
  test.setTimeout(60000)

  test.describe('Create Conversation', () => {
    test('crear nueva conversación desde estado vacío', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat si está cerrado
      await chatPage.open()

      // Assert: Verificar estado vacío inicial
      await chatPage.verifyEmptyState()

      // Assert: Verificar sugerencias de mensajes
      await chatPage.verifySuggestions()
    })

    test('crear conversación enviando primer mensaje', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Enviar primer mensaje para crear conversación
      const firstMessage = '¿Qué es un CFDI?'
      await chatPage.sendMessage(firstMessage)

      // Assert: Verificar que el mensaje del usuario está visible
      await chatPage.verifyUserMessage(firstMessage)

      // Assert: Verificar indicador de typing
      await expect(chatPage.typingIndicator).toBeVisible({ timeout: 5000 })

      // Assert: Esperar respuesta del asistente
      await chatPage.waitForResponse()

      // Assert: Verificar que hay respuesta del asistente
      await chatPage.verifyHasMessages()
    })

    test('crear conversación con mensaje sobre declaración fiscal', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Enviar mensaje sobre declaración (trigger de workflow)
      const workflowMessage = '¿Cuándo vence la declaración anual?'
      await chatPage.sendMessage(workflowMessage)

      // Assert: Verificar workflow processing
      await chatPage.verifyWorkflowProcessing().catch(() => {
        // El workflow indicator es opcional
      })

      // Assert: Esperar respuesta
      await chatPage.waitForResponse()

      // Assert: Verificar respuesta
      await chatPage.verifyAssistantResponseContains(/declaración|anual|fecha|vencimiento/i, 15000)
    })

    test('crear múltiples conversaciones', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Crear primera conversación
      await chatPage.sendMessage('Hola')
      await chatPage.waitForResponse()

      // Act: Crear segunda conversación (nuevo mensaje)
      await chatPage.sendMessage('¿Qué es el ISR?')
      await chatPage.waitForResponse()

      // Assert: Verificar que hay múltiples conversaciones
      await chatPage.openConversationsDropdown()
      await expect(chatPage.conversationItems.first()).toBeVisible({ timeout: 5000 })
    })
  })

  test.describe('Send Message', () => {
    test('enviar mensaje y recibir respuesta', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Enviar mensaje
      const testMessage = '¿Cómo deducir gastos del SAT?'
      await chatPage.sendMessage(testMessage)

      // Assert: Verificar mensaje enviado
      await chatPage.verifyUserMessage(testMessage)

      // Assert: Esperar y verificar respuesta
      await chatPage.waitForResponse()
      await chatPage.verifyAssistantResponseContains(/deducir|gastos|SAT|LISR/i, 20000)
    })

    test('enviar mensaje con streaming', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Enviar mensaje largo (para probar streaming)
      const longMessage = 'Explícame detalladamente el proceso de declaración anual de ISR para personas morales'
      await chatPage.sendMessage(longMessage)

      // Assert: Verificar typing indicator
      await expect(chatPage.typingIndicator).toBeVisible({ timeout: 5000 })

      // Assert: Esperar respuesta completa
      await chatPage.waitForResponse(30000)

      // Assert: Verificar que la respuesta tiene contenido
      await chatPage.verifyHasMessages()
    })

    test('enviar mensaje vacío no debería funcionar', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Intentar enviar mensaje vacío
      await chatPage.messageInput.fill('')
      
      // Assert: El botón de enviar debería estar deshabilitado
      const sendButton = chatPage.sendButton
      const isDisabled = await sendButton.isDisabled().catch(() => false)
      expect(isDisabled).toBe(true)
    })

    test('enviar múltiples mensajes en la misma conversación', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Enviar primer mensaje
      await chatPage.sendMessage('¿Qué es el IVA?')
      await chatPage.waitForResponse()

      // Act: Enviar segundo mensaje (seguimiento)
      await chatPage.sendMessage('¿Cuál es la tasa del IVA en México?')
      await chatPage.waitForResponse()

      // Act: Enviar tercer mensaje
      await chatPage.sendMessage('¿Cuándo se paga el IVA?')
      await chatPage.waitForResponse()

      // Assert: Verificar que hay múltiples mensajes
      const userMessages = await chatPage.userMessages.count()
      const assistantMessages = await chatPage.assistantMessages.count()
      
      expect(userMessages).toBeGreaterThanOrEqual(3)
      expect(assistantMessages).toBeGreaterThanOrEqual(3)
    })

    test('usar sugerencias de mensajes rápidos', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Assert: Verificar sugerencias
      await chatPage.verifySuggestions()

      // Act: Click en primera sugerencia
      const firstSuggestion = chatPage.suggestionButtons.first()
      await firstSuggestion.click()

      // Assert: Verificar que se envió el mensaje
      await chatPage.waitForResponse()
      await chatPage.verifyHasMessages()
    })
  })

  test.describe('Delete Conversation', () => {
    test('eliminar conversación desde el dropdown', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Crear una conversación primero
      await chatPage.sendMessage('Test conversation')
      await chatPage.waitForResponse()

      // Act: Abrir dropdown de conversaciones
      await chatPage.openConversationsDropdown()

      // Act: Eliminar conversación
      const deleteButton = chatPage.conversationItems.first().getByRole('button', { name: /delete|eliminar|trash/i })
      await deleteButton.click()

      // Assert: Verificar que la conversación fue eliminada
      // (el dropdown debería cerrarse o mostrar menos items)
      await expect(chatPage.conversationItems.first()).not.toBeVisible({ timeout: 5000 }).catch(() => {
        // Si hay más conversaciones, al menos verificamos que el count disminuyó
      })
    })

    test('eliminar conversación y verificar que se limpia el chat', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Crear conversación
      await chatPage.sendMessage('Delete me')
      await chatPage.waitForResponse()

      // Assert: Verificar que hay mensajes
      await chatPage.verifyHasMessages()

      // Act: Eliminar conversación
      await chatPage.openConversationsDropdown()
      const deleteButton = chatPage.conversationItems.first().getByRole('button', { name: /delete|eliminar|trash/i })
      await deleteButton.click()

      // Assert: Verificar que el chat está vacío (estado inicial)
      await chatPage.verifyEmptyState().catch(() => {
        // Puede que haya otras conversaciones
      })
    })

    test('confirmar eliminación de conversación', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Crear conversación
      await chatPage.sendMessage('Confirm delete')
      await chatPage.waitForResponse()

      // Act: Abrir dropdown y eliminar
      await chatPage.openConversationsDropdown()
      const deleteButton = chatPage.conversationItems.first().getByRole('button', { name: /delete|eliminar|trash/i })
      await deleteButton.click()

      // Assert: Verificar que la acción se completó
      // (puede haber confirmación o eliminación directa)
    })
  })

  test.describe('Chat UI Features', () => {
    test('ver historial de conversaciones', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Crear varias conversaciones
      await chatPage.sendMessage('Conversation 1')
      await chatPage.waitForResponse()
      
      await chatPage.sendMessage('Conversation 2')
      await chatPage.waitForResponse()

      // Act: Abrir dropdown de historial
      await chatPage.openConversationsDropdown()

      // Assert: Verificar que hay conversaciones en el historial
      await expect(chatPage.conversationItems.first()).toBeVisible({ timeout: 5000 })
    })

    test('seleccionar conversación del historial', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Crear conversación
      await chatPage.sendMessage('Select me')
      await chatPage.waitForResponse()

      // Act: Abrir dropdown y seleccionar
      await chatPage.openConversationsDropdown()
      await chatPage.conversationItems.first().click()

      // Assert: Verificar que la conversación se cargó
      await chatPage.verifyHasMessages()
    })

    test('cerrar y abrir chat', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Assert: Verificar que está visible
      await expect(chatPage.chatContainer.or(chatPage.chatHeader)).toBeVisible()

      // Act: Cerrar chat
      await chatPage.close()

      // Assert: Verificar que está cerrado
      const isVisible = await chatPage.isVisible()
      expect(isVisible).toBe(false)

      // Act: Abrir nuevamente
      await chatPage.open()

      // Assert: Verificar que está visible de nuevo
      await expect(chatPage.chatContainer.or(chatPage.chatHeader)).toBeVisible()
    })

    test('ver indicador de "AI Ready"', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Assert: Verificar badge "AI Ready"
      await expect(
        chatPage.page.getByText(/ai ready|ready|disponible/i)
      ).toBeVisible({ timeout: 3000 })
    })

    test('ver timestamp en mensajes', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Enviar mensaje
      await chatPage.sendMessage('Timestamp test')
      await chatPage.waitForResponse()

      // Assert: Verificar timestamp en mensajes
      await expect(
        chatPage.page.locator('[class*="time"], [class*="date"]').or(
          chatPage.page.getByText(/\d{1,2}:\d{2}/).first()
        )
      ).toBeVisible({ timeout: 5000 })
    })
  })

  test.describe('Chat Error Handling', () => {
    test('manejar error de conexión', async ({ authenticatedPage, page }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Simular error de red (opcional)
      // Esto depende de cómo quieras probar errores

      // Assert: Verificar que hay manejo de errores
      // (mensaje de error o retry option)
    })

    test('mensaje muy largo', async ({ authenticatedPage }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Abrir el chat
      await chatPage.open()

      // Act: Enviar mensaje muy largo
      const longMessage = 'A'.repeat(1000)
      await chatPage.sendMessage(longMessage)

      // Assert: Verificar que se envió y hay respuesta
      await chatPage.waitForResponse()
      await chatPage.verifyHasMessages()
    })
  })

  test.describe('Chat Responsive', () => {
    test('chat en viewport móvil', async ({ authenticatedPage, page }) => {
      // Arrange: Ya estamos autenticados
      const { chatPage } = authenticatedPage

      // Act: Cambiar a viewport móvil
      await page.setViewportSize({ width: 375, height: 667 })

      // Act: Abrir el chat
      await chatPage.open()

      // Assert: Verificar que el chat es visible y funcional
      await expect(chatPage.chatHeader).toBeVisible({ timeout: 3000 })

      // Act: Enviar mensaje
      await chatPage.sendMessage('Mobile test')
      await chatPage.waitForResponse()

      // Assert: Verificar respuesta
      await chatPage.verifyHasMessages()
    })
  })
})
