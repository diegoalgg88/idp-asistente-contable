# Backend API Configuration
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# API Timeout (milliseconds)
VITE_API_TIMEOUT=30000

# Feature Flags (optional)
# VITE_ENABLE_STREAMING=true
# VITE_ENABLE_BATCH_PROCESSING=true

# =============================================================================
# SENTRY ERROR TRACKING
# =============================================================================
# Get your DSN from Sentry.io project settings
# Frontend project: Create a React project in Sentry
VITE_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# Environment (development, staging, production)
VITE_SENTRY_ENVIRONMENT=development

# App version for error tracking (optional, auto-detected in build)
VITE_APP_VERSION=1.0.0

# =============================================================================
# SENTRY SOURCE MAPS UPLOAD (NO COMMITTEAR VALORES REALES)
# =============================================================================
# These values are used only during build for uploading source maps
# Get your auth token from: https://sentry.io/settings/account/api/auth-tokens/
# Required scopes: project:releases, project:read, org:read
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_...
