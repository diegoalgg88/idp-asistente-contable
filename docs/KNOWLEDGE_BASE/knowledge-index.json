      {"name": "Vite", "purpose": "Build tool"},
      {"name": "Tailwind CSS", "purpose": "Styling"},
      {"name": "shadcn/ui", "purpose": "Component library"},
      {"name": "Radix UI", "purpose": "Accessible primitives"},
      {"name": "Zustand", "purpose": "State management"},
      {"name": "React Router", "purpose": "Routing"},
      {"name": "Recharts", "purpose": "Charts"},
      {"name": "Axios", "purpose": "HTTP client"},
      {"name": "Playwright", "purpose": "E2E testing"},
      {"name": "Vitest", "purpose": "Unit testing"}
    ],
    "nvidia_nim_api": [
      {"name": "NemoRetriever-OCR-v1", "purpose": "OCR para documentos"},
      {"name": "NemoRetriever-Table-Structure-v1", "purpose": "Extracción de tablas"},
      {"name": "Llama-3.2-90b-Vision-Instruct", "purpose": "Vision LLM para extracción"},
      {"name": "Llama-3.3-70b-Instruct", "purpose": "Text LLM para razonamiento"},
      {"name": "NV-EmbedQA-E5-V5", "purpose": "Embeddings para RAG"},
      {"name": "NV-RerankQA-Mistral-4b-v3", "purpose": "Reranking para RAG"}
    ]
  },
  "infrastructure": {
    "docker_services": [
      {"name": "redis", "image": "redis:7-alpine", "port": 6379, "purpose": "Rate limiting & cache"},
      {"name": "db", "image": "postgres:15-alpine", "port": 5432, "purpose": "PostgreSQL database"},
      {"name": "chromadb", "image": "chromadb/chroma:latest", "port": 8000, "purpose": "Vector store"},
      {"name": "backend", "build": "./backend", "port": 8000, "purpose": "FastAPI backend"},
      {"name": "frontend-dev", "build": "./frontend", "port": 5173, "purpose": "React frontend (dev)", "profile": "dev"},
      {"name": "frontend", "build": "./frontend", "port": 3000, "purpose": "React frontend (prod)", "profile": "prod"}
