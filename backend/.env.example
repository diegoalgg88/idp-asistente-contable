# =============================================================================
# IDP Asistente Contable - Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env
# =============================================================================

# =============================================================================
# NVIDIA API CONFIGURATION
# =============================================================================
# Get your API key from: https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-actual-api-key-here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For Docker Compose (using postgres service)
DATABASE_URL=postgresql://idp_user:idp_password@db:5432/idp_contable

# For local development (without Docker)
# DATABASE_URL=postgresql://idp_user:idp_password@localhost:5432/idp_contable

POSTGRES_USER=idp_user
POSTGRES_PASSWORD=idp_password
POSTGRES_DB=idp_contable
POSTGRES_HOST=db
POSTGRES_PORT=5432

# =============================================================================
# CHROMADB CONFIGURATION
# =============================================================================
CHROMA_DB_HOST=chromadb
CHROMA_DB_PORT=8000
CHROMA_DB_COLLECTION=contable_documents

# For local development (without Docker)
# CHROMA_DB_HOST=localhost
# CHROMA_DB_PORT=8000

# =============================================================================
# SECURITY
# =============================================================================
# IMPORTANT: Change this in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
APP_NAME="IDP Asistente Contable"
APP_VERSION=2.0.0

# =============================================================================
# RATE LIMITING
# =============================================================================
# NVIDIA NIM Develop tier: 40 RPM
# NVIDIA NIM Production tier: 100+ RPM
RATE_LIMIT=40

# =============================================================================
# NVIDIA NIM ENDPOINTS
# =============================================================================
# Vision LLM (for invoice extraction)
VISION_NIM_BASE_URL=https://ai.api.nvidia.com/v1/gr
VISION_MODEL=meta/llama-3.2-90b-vision-instruct

# Text LLM (for reasoning)
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# OCR
NVIDIA_NIM_BASE_URL=https://ai.api.nvidia.com/v1/cv
OCR_MODEL=nvidia/nemoretriever-ocr-v1
TABLE_MODEL=nvidia/nemoretriever-table-structure-v1

# Embeddings
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Reranking
RERANK_MODEL=nvidia/nv-rerankqa-mistral-4b-v3

# =============================================================================
# PROCESSING LIMITS
# =============================================================================
MAX_WORKERS=4
REQUEST_TIMEOUT=120
MAX_FILE_SIZE=10485760  # 10 MB in bytes

# =============================================================================
# FILE STORAGE
# =============================================================================
UPLOAD_DIR=uploads
DATASET_PDF_PATH=dataset/pdf
DATASET_XML_PATH=dataset/xml
OUTPUT_PATH=output

# =============================================================================
# CORS
# =============================================================================
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://frontend:5173

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/idp_backend.log

# =============================================================================
# LANGGRAPH
# =============================================================================
LANGGRAPH_DEBUG=false
LANGGRAPH_CHECKPOINT=true

# =============================================================================
# SENTRY - Error Monitoring & Performance (Optional)
# =============================================================================
# Get your DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# Environment: development, staging, production
# SENTRY_ENVIRONMENT=development

# Traces sample rate (1.0 = 100%, reduce to 0.1-0.2 in production)
# SENTRY_TRACES_SAMPLE_RATE=1.0

# Profiles sample rate (0.5 = 50%)
# SENTRY_PROFILES_SAMPLE_RATE=0.5

# Enable SDK debug output
# SENTRY_DEBUG=false
